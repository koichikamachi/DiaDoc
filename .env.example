# Dialectic-BizDoctor の環境変数（.env にコピーして値を入れる。.env はリポジトリに含めない）

# Gemini API キー（未設定ならファイル読み取りはモック動作）
GEMINI_API_KEY=

# 読み取りに使うモデル（既定：gemini-3.8-flash）
GEMINI_MODEL=gemini-3.8-flash

# モックに固定したいとき（デモの再現など）は mock を指定
DBD_EXTRACTOR=

# 今後の Phase で使うもの
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
EDINET_API_KEY=d4736063d7a2409a9fbc07a39fb35857
